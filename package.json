{
  "name": "vscode-lifeline",
  "displayName": "Lifeline: Clock & battery",
  "description": "Display a clock and current battery state in the status bar.",
  "version": "2.0.0",
  "author": "Kyle Huggins (http://huggins.io/)",
  "license": "MIT",
  "homepage": "https://github.com/CodeNoEvil/vscode-lifeline#readme",
  "publisher": "kjhx",
  "icon": "media/icon.jpg",
  "galleryBanner": {
    "color": "#25292E",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeNoEvil/vscode-lifeline"
  },
  "bugs": {
    "url": "https://github.com/CodeNoEvil/vscode-lifeline/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Lifeline",
      "properties": {
        "lifeline.swap": {
          "type": "boolean",
          "default": false,
          "description": "Swap the display order of the battery and clock. Ignored if the device has no battery."
        },
        "lifeline.clock.format": {
          "type": "string",
          "default": "h:mm:ss A",
          "description": "Clock format. Tokens match the common moment set (h, hh, H, HH, m, mm, s, ss, A, a, and date tokens). Wrap literal text in [brackets]."
        },
        "lifeline.clock.interval": {
          "type": "number",
          "default": 1000,
          "minimum": 1000,
          "description": "Polling interval for the clock, in milliseconds."
        },
        "lifeline.battery.interval": {
          "type": "number",
          "default": 3000,
          "minimum": 1000,
          "description": "Polling interval for the battery, in milliseconds. Ignored if the device has no battery."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "tsc -p tsconfig.test.json && node --test out-test/test/power.test.js",
    "lint": "eslint .",
    "check": "tsc -p ./ --noEmit",
    "vscode:prepublish": "npm run check && npm test && npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.28.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.34.0"
  }
}
